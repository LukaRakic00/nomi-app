# Kopiraj u `.env.local` i popuni vrednosti. `.env.local` se ne commit-uje.

# Javna adresa sajta. Koristi se za metadata, canonical URL, sitemap i robots.
# U produkciji obavezno postavi na pravi domen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPCIONO — postavi samo ako projekat komunicira sa backend API-jem.
# Ako projekat nema backend, ostavi zakomentarisano i obriši `lib/http.ts`.
# NEXT_PUBLIC_API_URL=https://api.primer.rs

# Tajne (API ključevi, tokeni, konekcioni stringovi) NIKADA ne nose prefiks
# NEXT_PUBLIC_ jer bi tada završile u browser bundle-u. Dodaj ih u shemu u
# `lib/env.server.ts` i čitaj isključivo iz serverskog koda.
